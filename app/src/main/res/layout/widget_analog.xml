<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_open"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="10dp"
    android:paddingEnd="9dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:background="@drawable/widget_card_bg">
    <ImageView
        android:id="@+id/widget_art"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginEnd="11dp"
        android:scaleType="centerCrop"
        android:src="@android:drawable/ic_menu_gallery"
        android:background="@drawable/widget_art_bg"
        android:clipToOutline="true"
        android:contentDescription="Album artwork" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ANALOG  /  NOW PLAYING"
            android:textColor="#FFB45B"
            android:textStyle="bold"
            android:textSize="8sp"
            android:letterSpacing="0.12" />
        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Choose a track"
            android:textColor="#F2F0E8"
            android:textStyle="bold"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/widget_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Your offline music"
            android:textColor="#B5D69B"
            android:textSize="10sp"
            android:maxLines="1"
            android:ellipsize="end" />
        <ProgressBar
            android:id="@+id/widget_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="8dp"
            android:max="1000"
            android:progress="0"
            android:progressTint="#FFB45B"
            android:progressBackgroundTint="#44483F" />
    </LinearLayout>
    <ImageButton
        android:id="@+id/widget_previous"
        android:layout_width="38dp"
        android:layout_height="48dp"
        android:layout_marginStart="7dp"
        android:src="@drawable/widget_ic_prev"
        android:contentDescription="Previous track"
        android:background="@android:color/transparent"
        android:scaleType="centerInside"
        android:padding="8dp" />
    <ImageButton
        android:id="@+id/widget_play"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginStart="1dp"
        android:src="@drawable/widget_ic_play"
        android:contentDescription="Play or pause"
        android:background="@drawable/widget_play_bg"
        android:scaleType="centerInside"
        android:padding="10dp" />
    <ImageButton
        android:id="@+id/widget_next"
        android:layout_width="38dp"
        android:layout_height="48dp"
        android:src="@drawable/widget_ic_next"
        android:contentDescription="Next track"
        android:background="@android:color/transparent"
        android:scaleType="centerInside"
        android:padding="8dp" />
</LinearLayout>