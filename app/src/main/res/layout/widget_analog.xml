<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_open"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="#1A1C18">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ANALOG"
        android:textColor="#FFB45B"
        android:textStyle="bold"
        android:textSize="10sp"
        android:letterSpacing="0.18" />
    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Choose a track"
        android:textColor="#E8E1CF"
        android:textStyle="bold"
        android:textSize="14sp"
        android:maxLines="1"
        android:ellipsize="end" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical">
        <ImageView
            android:id="@+id/widget_art"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginEnd="8dp"
            android:scaleType="centerCrop"
            android:src="@android:drawable/ic_menu_gallery"
            android:tint="#B5D69B"
            android:contentDescription="Album artwork" />
        <TextView
            android:id="@+id/widget_artist"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="ANALOG • OFFLINE"
            android:textColor="#B5D69B"
            android:textSize="10sp"
            android:maxLines="1"
            android:ellipsize="end" />
        <ImageButton
            android:id="@+id/widget_previous"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_media_previous"
            android:contentDescription="Previous"
            android:background="@android:color/transparent"
            android:tint="#E8E1CF" />
        <ImageButton
            android:id="@+id/widget_play"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@android:drawable/ic_media_play"
            android:contentDescription="Play or pause"
            android:background="@android:color/transparent"
            android:tint="#FFB45B" />
        <ImageButton
            android:id="@+id/widget_next"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_media_next"
            android:contentDescription="Next"
            android:background="@android:color/transparent"
            android:tint="#E8E1CF" />
    </LinearLayout>
</LinearLayout>
