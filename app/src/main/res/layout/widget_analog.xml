<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_open"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="5dp"
    android:paddingEnd="3dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp"
    android:background="#1A1C18">
    <ImageView
        android:id="@+id/widget_art"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="5dp"
        android:scaleType="centerCrop"
        android:src="@android:drawable/ic_menu_gallery"
        android:background="#292D28"
        android:contentDescription="Album artwork" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ANALOG"
            android:textColor="#FFB45B"
            android:textStyle="bold"
            android:textSize="9sp"
            android:letterSpacing="0.16" />
        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="Choose a track"
            android:textColor="#F2F0E8"
            android:textStyle="bold"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/widget_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:text="Your offline music"
            android:textColor="#B5D69B"
            android:textSize="9sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>
    <ImageButton
        android:id="@+id/widget_previous"
        android:layout_width="28dp"
        android:layout_height="42dp"
        android:src="@android:drawable/ic_media_previous"
        android:contentDescription="Previous"
        android:background="@android:color/transparent"
        android:tint="#E8E1CF" />
    <ImageButton
        android:id="@+id/widget_play"
        android:layout_width="34dp"
        android:layout_height="42dp"
        android:src="@android:drawable/ic_media_play"
        android:contentDescription="Play or pause"
        android:background="@android:color/transparent"
        android:tint="#FFB45B" />
    <ImageButton
        android:id="@+id/widget_next"
        android:layout_width="38dp"
        android:layout_height="48dp"
        android:src="@android:drawable/ic_media_next"
        android:contentDescription="Next"
        android:background="@android:color/transparent"
        android:tint="#E8E1CF" />
</LinearLayout>
